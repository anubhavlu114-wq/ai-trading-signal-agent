    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze the following market data and generate the JSON trading signal.\n\nTarget Symbol: {{ $('Telegram Trigger').item.json.message.text || 'Unknown' }}\n\n--- 1. PRICE DATA (Latest Intervals) ---\n{{ JSON.stringify($('Merge').all(), null, 2) }}\n\n--- 2. LATEST NEWS & SENTIMENT ---\n{{ JSON.stringify($('HTTP Request').item.json.articles, null, 2) }}",
        "options": {
          "systemMessage": "You are an autonomous algorithmic trading agent analyzing short-term market data. \nYour objective is to evaluate combined price action data and recent news headlines to generate a clear, actionable trading signal.\n\nRULES:\n1. You must remain completely objective and analytical.\n2. Evaluate technical data (trends) and fundamental data (news sentiment) equally.\n3. You must output ONLY a valid raw JSON object. Do not include markdown formatting (like ```json), conversational text, or explanations outside the JSON structure.\n\nJSON OUTPUT FORMAT:\n{\n  \"symbol\": \"[Stock Symbol]\",\n  \"signal\": \"BUY\" | \"SELL\" | \"HOLD\",\n  \"confidenceScore\": [A number between 1 and 10],\n  \"reasoning\": \"[1-2 concise sentences explaining the primary driver for this signal based on the provided data]\"\n}"
        }
      },
